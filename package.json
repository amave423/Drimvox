{
  "name": "artel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @artel/web && npm run build -w @artel/desktop",
    "start": "npm run build && npm run start -w @artel/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run test && npm run e2e",
    "live-check": "node scripts/live-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
